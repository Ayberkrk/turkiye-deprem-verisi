venv/
__pycache__/
*.pyc
.DS_Store
.ipynb_checkpoints/
.pytest_cache/

# Yerel çalışma notları, repoya girmez
CLAUDE.md

# Ham/büyük veri dosyaları repo'ya girmez, scriptlerle yeniden üretilir
data/raw/*
!data/raw/.gitkeep
data/processed/*.mseed
data/processed/*.h5
data/processed/*.hdf5

# Gerçek dalga formu dosyaları artık burada değil, Hugging Face Hub'da
# barındırılıyor (bkz. README "Veriyi indirme"): hf download ile buraya
# indirilebilir, ama git tarafından takip edilmez (geçmişten de git
# filter-repo ile çıkarıldı, bkz. CHANGELOG v5.3)
data/processed/waveforms/

# İstasyon tepki bilgisi önbelleği: bayt olarak küçük ama metin satırı
# olarak devasa (StationXML), tamamen API'den yeniden üretilebilir
data/processed/response_cache/

# Çalıştırma logları, veri değil
data/processed/*.log

# Build-time önbellek/checkpoint dosyaları - dokümante edilmiş bir veri
# ürünü değil (waveform_fetch_log.csv'nin aksine), scriptlerle yeniden
# üretilir
data/processed/expanded_catalog_raw_cache.parquet
data/processed/isc_picks_progress.csv

# Kişisel/kimlik bilgisi olabilecek dosyalar asla commit edilmez
.env
*credentials*

# git commit -F için kullanılan geçici commit mesajı dosyası, repoya girmemeli
COMMIT_MESSAGE.txt

# HuggingFace dataset repo'suna yüklenen veri kartı, bu (kod) reposuna
# değil, ayrı bir HF dataset reposuna aittir
HF_DATASET_CARD.md
